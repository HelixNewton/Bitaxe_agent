MINER_NAME=Bitaxe
MINER_URL=http://192.168.1.50
MINER_API_PROFILE=axeos
MINER_INFO_PATH=/api/system/info
MINER_ASIC_PATH=/api/system/asic
MINER_SETTINGS_PATH=/api/system
MINER_RESTART_PATH=/api/system/restart
MINER_STATUS_FILE=status.json
MINER_LEARNING_FILE=learning.json
MINER_UI_HOST=127.0.0.1
MINER_UI_PORT=8787

# Backward-compatible alias. MINER_URL is preferred for portable multi-miner configs.
BITAXE_URL=http://192.168.1.50
BITAXE_MODE=rules
BITAXE_DRY_RUN=true
BITAXE_AUTO_FAN=true
BITAXE_LOOP_SECONDS=30
BITAXE_MIN_FREQUENCY=500
BITAXE_MAX_FREQUENCY=545
BITAXE_ABSOLUTE_MAX_FREQUENCY=625
BITAXE_FREQ_STEP=5
BITAXE_MIN_VOLTAGE=980
BITAXE_MAX_VOLTAGE=1100
BITAXE_ABSOLUTE_MAX_VOLTAGE=1150
BITAXE_VOLTAGE_STEP=5
BITAXE_TARGET_TEMP_C=65
BITAXE_HOT_TEMP_C=69
BITAXE_EMERGENCY_TEMP_C=70
BITAXE_ABSOLUTE_MAX_EMERGENCY_TEMP_C=70
BITAXE_COOL_TEMP_C=63
BITAXE_MAX_VR_TEMP_C=70
BITAXE_ABSOLUTE_MAX_VR_TEMP_C=75
BITAXE_MIN_INPUT_VOLTAGE_MV=4800
BITAXE_MAX_POWER_W=16.5
BITAXE_ABSOLUTE_MAX_POWER_W=18
BITAXE_CLIMB_POWER_RATIO=0.90
BITAXE_MIN_FAN_PERCENT=60
BITAXE_MAX_FAN_PERCENT=100
BITAXE_STEP_COOLDOWN_SECONDS=180
BITAXE_MIN_HASHRATE_GH=0
BITAXE_USE_ASIC_OPTIONS=false
BITAXE_MAX_ERROR_PERCENTAGE=20
BITAXE_MAX_DOMAIN_SPREAD_PERCENTAGE=10
BITAXE_CRITICAL_DOMAIN_SPREAD_PERCENTAGE=18
BITAXE_DOMAIN_SPREAD_POLLS=2
BITAXE_LEARNING_ENABLED=true
BITAXE_LEARNING_MIN_SAMPLES=3
BITAXE_LEARNING_BAD_LIMIT=2
BITAXE_LEARNING_RESTORE_MARGIN=0.03
BITAXE_LEARNING_EFFICIENCY_WEIGHT=0.25
BITAXE_ADAPTIVE_COOLDOWN_ENABLED=true
BITAXE_ADAPTIVE_MIN_COOLDOWN_SECONDS=45
BITAXE_ADAPTIVE_MAX_COOLDOWN_SECONDS=240
BITAXE_ADAPTIVE_STABLE_SAMPLES=8
BITAXE_STATUS_FILE=status.json
BITAXE_LEARNING_FILE=learning.json
BITAXE_UI_HOST=127.0.0.1
BITAXE_UI_PORT=8787

# OpenAI advisor mode. Keep BITAXE_MODE=rules until dry-run telemetry looks sane.
# BITAXE_MODE=openai
# Add your AI API key here only in your private .env file.
# AI_MODEL=gpt-4.1-mini
