[Unit]
Description=Bitaxe Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/x/git/bitaxe_agent
EnvironmentFile=/home/x/git/bitaxe_agent/.env
ExecStart=/usr/bin/python3 /home/x/git/bitaxe_agent/controller.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
