[Unit]
Description=Bitaxe Agent UI
After=network-online.target bitaxe-agent.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/x/git/bitaxe_agent
EnvironmentFile=/home/x/git/bitaxe_agent/.env
ExecStart=/usr/bin/python3 /home/x/git/bitaxe_agent/ui_server.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
